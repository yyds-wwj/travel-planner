# ============================================================
# 旅游攻略多智能体系统 - 环境配置
# 复制为 .env 并填入真实 Key
# ============================================================

# --- AI Provider ---
ANTHROPIC_API_KEY=sk-xxx
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# --- 模型选型（大小模型分离）---
# Lead Agent（大模型）：负责任务编排、冲突协调、最终整合
LEAD_MODEL=deepseek-v4-pro[1m]
# Expert Agent（小模型）：负责单一领域任务，快速响应即可
EXPERT_MODEL=deepseek-v4-flash
# 通用 fallback（当上面两个未设置时使用）
MODEL_ID=deepseek-v4-pro[1m]

# --- 高德地图 API ---
AMAP_API_KEY=你的高德Key
